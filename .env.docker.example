# ============================================================================
#  Environment untuk deploy via Docker (compose / PaaS).
#  Salin ke .env.docker lalu isi APP_KEY.
#    cp .env.docker.example .env.docker
# ============================================================================

APP_NAME="Batik TrustYou"
APP_ENV=production
# Wajib diisi. Generate: docker compose run --rm app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Ganti sesuai domain/host publik saat produksi (mis. https://batik.example.com)
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# --- Database (MySQL via service `db`) --------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=batik
DB_USERNAME=batik
DB_PASSWORD=secret
# Password root MySQL (dipakai container db & healthcheck compose)
DB_ROOT_PASSWORD=rootsecret

# --- Driver bawaan pakai database (tanpa Redis) ----------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Service chatbot (di-override oleh compose ke http://chatbot:8001) ------
CHATBOT_URL=http://chatbot:8001

# --- Isi data contoh (produk, admin, dll). Set true HANYA saat pertama kali,
#     lalu kembalikan ke false agar tidak menumpuk data. -----------------------
RUN_SEED=true

# Log ke stdout supaya kebaca lewat `docker compose logs`
LOG_CHANNEL=stderr
LOG_LEVEL=info

MAIL_MAILER=log
